# HD Sentinel 指标阈值邮件告警配置
# 本文件在仓库中保存为 email.conf.example(模板); 安装 deb/rpm 后默认
# 即为 /etc/hdsentinel/email.conf(不带 .example 后缀), 直接编辑修改并 chmod 600。

[smtp]
# SMTP 服务器(默认本机 25 端口非加密中继)
# 常见组合: 25=非加密/STARTTLS(use_tls); 465=SMTPS(use_ssl); 587=STARTTLS(use_tls)
host = localhost
port = 25
# 登录凭据(留空表示匿名/本机中继)
user =
password =
# 加密方式: 三者互斥
#   use_ssl=true  -> SMTPS(465, 全程加密)
#   use_tls=true  -> 先用明文连 25/587 再 STARTTLS 升级加密
#   use_ssl=use_tls=false -> 25 端口纯明文(本机中继/内网常见)
# 注意: use_ssl 与 use_tls 只能一个为 true, 且要与 port 匹配
use_ssl = false
use_tls = false
# 收发件人
# from_name: 发件人显示名称(可选)。设置后邮件头 From 显示为 "名称 <from>";
#            留空则直接使用 from(也可写成 "名称 <地址>" 形式内联显示名)。
#            注意: 信封发件人(MAIL FROM)始终只取 from 中的裸邮箱地址, 与 from_name 无关。
from_name =
from = hdsentinel@yourhost.local
to = admin@example.com, oncall@example.com
subject_prefix = [HD Sentinel Alert]

[alert]
# 只在任一指标超阈值时发送告警邮件; 全部正常则不发信。
# (早期版本的 mode = daily 「每次运行都发完整报告」已移除, 残留的 mode 键会被忽略)
# 任一磁盘健康度低于该值(%)触发告警
health_min = 60
# 任一磁盘性能低于该值(%)触发告警
performance_min = 60
# 任一磁盘当前温度高于该值(℃)触发告警
temp_max = 50
# 任一磁盘历史最高温度高于该值(℃)触发告警
highest_temp_max = 65
# 同一告警冷却时间(分钟), 0 表示不冷却; 避免指标持续异常时邮件轰炸
cooldown_minutes = 60
# 告警状态文件(记录上次告警签名和时间)
state_file = /var/lib/hdsentinel/email-alert-state.json
# 邮件正文格式(两种报告均借助 hdsentinel 原生能力生成, 都只含"有问题的盘")
#   text = "问题报告": 第一遍纯文本解析阈值后, 第二遍用原生 -onlydevs 只检测问题盘,
#          由 hdsentinel 自身生成纯文本报告, 仅含问题盘, 格式与完整报告一致
#   html  = "问题报告"(默认): 同样第二遍用原生 -onlydevs -html -r 生成仅含问题盘的 HTML 报告,
#          顶部附问题盘摘要
#   说明: 两遍流程 —— 第一遍始终跑纯文本(供阈值解析), 第二遍按此处格式追加参数只报问题盘
report_format = html

[hdsentinel]
# hdsentinel 二进制路径
path = /opt/hdsentinel/hdsentinel
# 额外参数: 留空输出完整报告(推荐, 可解析各指标); -solid 输出单行摘要
extra_args =

#!/usr/bin/env bash
# hdsentinel-email-alert — HD Sentinel 指标阈值邮件告警 (bash + curl 版)
#
# 运行 Hard Disk Sentinel，按磁盘解析健康度/性能/温度等指标，任一指标超出阈值时
# 通过 SMTP (curl) 发送邮件告警。支持对持续相同告警做冷却，避免邮件轰炸。
#
# 配置文件: /etc/hdsentinel/email.conf  (INI 格式, 见 email.conf.example)
# 也可用环境变量 HDSENTINEL_EMAIL_CONF 指定其它路径。
# 依赖: bash(4+)、curl、coreutils(timeout/sha256sum/date/base64)、grep/sed。
set -o pipefail

DEFAULT_CONF="/etc/hdsentinel/email.conf"
DEFAULT_STATE_FILE="/var/lib/hdsentinel/email-alert-state.json"

declare -A CFG

# ---------------------------------------------------------------- 配置读取 ---
# 与 python configparser 行为对齐: 段名/键名转小写, 值去掉首尾空白,
# 仅支持整行注释(行首 # 或 ;), 键值内联的 # 不做注释处理。

set_defaults() {
  CFG=(
    [smtp.host]=localhost
    [smtp.port]=25
    [smtp.user]=""
    [smtp.password]=""
    [smtp.use_tls]=false
    [smtp.use_ssl]=false
    [smtp.from]=hdsentinel@localhost
    [smtp.to]=root@localhost
    [smtp.subject_prefix]="[HD Sentinel Alert]"
    [alert.mode]=alert
    [alert.health_min]=60
    [alert.performance_min]=60
    [alert.temp_max]=55
    [alert.highest_temp_max]=65
    [alert.cooldown_minutes]=60
    [alert.state_file]=$DEFAULT_STATE_FILE
    [hdsentinel.path]=/opt/hdsentinel/hdsentinel
    [hdsentinel.extra_args]=""
  )
}

parse_conf() {
  local file="$1" section="" key val line
  [[ -f "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"                                   # 兼容 CRLF
    line="${line#"${line%%[![:space:]]*}"}"                # 去行首空白
    [[ -z "$line" || "$line" == [#\;]* ]] && continue
    if [[ "$line" == \[*\] ]]; then
      section="${line#\[}"; section="${section%\]}"
      section="${section,,}"; section="${section//[[:space:]]/}"
      continue
    fi
    if [[ "$line" == *=* && -n "$section" ]]; then
      key="${line%%=*}"; key="${key,,}"; key="${key//[[:space:]]/}"
      val="${line#*=}"
      val="${val#"${val%%[![:space:]]*}"}"                 # 去值首空白
      val="${val%"${val##*[![:space:]]}"}"                 # 去值尾空白
      CFG["$section.$key"]="$val"
    fi
  done < "$file"
}

# 布尔值解析, 与 configparser.getboolean 一致
bool_cfg() {  # bool_cfg <section.key> <default>
  local v="${CFG[$1]:-$2}"
  case "${v,,}" in
    true|yes|on|1) return 0 ;;
    *)             return 1 ;;
  esac
}

# ---------------------------------------------------------------- 报告解析 ---
# hdsentinel 完整报告按空行拆成块, 每块含 "HDD Device" 即视为一个磁盘;
# 提取 设备/型号/温度/历史最高温度/健康度/性能。正则与 python 版一一对应。

extract() {  # extract <text> <regex> -> 打印捕获组 1
  local t="$1" p="$2"
  if [[ "$t" =~ $p ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  fi
}

parse_disks() {
  local block="" line
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ -z "$line" ]]; then
      [[ -n "$block" ]] && add_disk "$block"
      block=""
    else
      block+="$line"$'\n'
    fi
  done
  [[ -n "$block" ]] && add_disk "$block"
}

# 注意: bash `=~` 中 `.` 会匹配换行, 因此必须按行提取, 不能对整块做 `(.+)` 捕获。
add_disk() {
  local block="$1"
  [[ "$block" == *"HDD Device"* ]] || return
  local device="" model="" temp="" htemp="" health="" perf="" line
  while IFS= read -r line; do
    case "$line" in
      *"HDD Device"*)
        [[ -n "$device" ]] || device="$(extract "$line" 'HDD Device[[:space:]]*\(?[0-9]*\)?[[:space:]]*:[[:space:]]*(.+)')"
        ;;
      *"HDD Model ID"*)
        [[ -n "$model" ]] || model="$(extract "$line" 'HDD Model ID[[:space:]]*:[[:space:]]*(.+)')"
        ;;
      *"Temperature"*)
        [[ -n "$temp" ]] || temp="$(extract "$line" 'Temperature[[:space:]]*:[[:space:]]*([0-9]+)')"
        ;;
      *"Highest Temp"*)
        [[ -n "$htemp" ]] || htemp="$(extract "$line" 'Highest Temp\.?[[:space:]]*:[[:space:]]*([0-9]+)')"
        ;;
      *"Health"*)
        [[ -n "$health" ]] || health="$(extract "$line" 'Health[[:space:]]*:[[:space:]]*([0-9]+)')"
        ;;
      *"Performance"*)
        [[ -n "$perf" ]] || perf="$(extract "$line" 'Performance[[:space:]]*:[[:space:]]*([0-9]+)')"
        ;;
    esac
  done <<<"$block"
  DEV_DEVICE+=("$device")
  DEV_MODEL+=("$model")
  DEV_TEMP+=("$temp")
  DEV_HTEMP+=("$htemp")
  DEV_HEALTH+=("$health")
  DEV_PERF+=("$perf")
}

# ---------------------------------------------------------------- 阈值评估 ---
evaluate() {
  VIO_DEV=() VIO_MODEL=() VIO_METRIC=() VIO_VALUE=() VIO_THR=()
  local i d m
  for i in "${!DEV_DEVICE[@]}"; do
    d="${DEV_DEVICE[$i]}"
    m="${DEV_MODEL[$i]:-未知型号}"
    if [[ -n "${DEV_HEALTH[$i]}" ]] && (( ${DEV_HEALTH[$i]} < HEALTH_MIN )); then
      VIO_DEV+=("$d"); VIO_MODEL+=("$m"); VIO_METRIC+=("健康度")
      VIO_VALUE+=("${DEV_HEALTH[$i]}%"); VIO_THR+=("< $HEALTH_MIN%")
    fi
    if [[ -n "${DEV_PERF[$i]}" ]] && (( ${DEV_PERF[$i]} < PERF_MIN )); then
      VIO_DEV+=("$d"); VIO_MODEL+=("$m"); VIO_METRIC+=("性能")
      VIO_VALUE+=("${DEV_PERF[$i]}%"); VIO_THR+=("< $PERF_MIN%")
    fi
    if [[ -n "${DEV_TEMP[$i]}" ]] && (( ${DEV_TEMP[$i]} > TEMP_MAX )); then
      VIO_DEV+=("$d"); VIO_MODEL+=("$m"); VIO_METRIC+=("温度")
      VIO_VALUE+=("${DEV_TEMP[$i]}℃"); VIO_THR+=("> $TEMP_MAX℃")
    fi
    if [[ -n "${DEV_HTEMP[$i]}" ]] && (( ${DEV_HTEMP[$i]} > HI_MAX )); then
      VIO_DEV+=("$d"); VIO_MODEL+=("$m"); VIO_METRIC+=("历史最高温度")
      VIO_VALUE+=("${DEV_HTEMP[$i]}℃"); VIO_THR+=("> $HI_MAX℃")
    fi
  done
}

build_summary() {
  printf '检测到 %d 个磁盘，其中 %d 项指标异常：\n' "${#DEV_DEVICE[@]}" "${#VIO_DEV[@]}"
  local i
  for i in "${!VIO_DEV[@]}"; do
    printf '  • %s (%s): %s 当前 %s，阈值 %s\n' \
      "${VIO_DEV[$i]}" "${VIO_MODEL[$i]}" "${VIO_METRIC[$i]}" "${VIO_VALUE[$i]}" "${VIO_THR[$i]}"
  done
  printf '\n完整报告：\n%s' "$REPORT"
}

# ---------------------------------------------------------------- 告警冷却 ---
# 签名算法与 python 版一致: 对 "device|model|metric|value" 排序后
# sha256("\n".join(sorted)) 取前 16 位十六进制; 状态文件保持 JSON 格式兼容。

iso_now() {
  local d z
  d="$(date -u +%Y-%m-%dT%H:%M:%S.%N)"
  z="$(date -u +%z)"                       # +0000
  z="${z:0:3}:${z:3:2}"                    # +00:00
  printf '%s%s\n' "$d" "$z"
}

update_state() {
  mkdir -p "$(dirname "$STATE_FILE")"
  printf '{"last_signature": "%s", "last_alert_time": "%s"}\n' "$SIG" "$(iso_now)" > "$STATE_FILE"
}

cooldown_check() {
  # 计算本次告警签名
  local -a sig_parts=()
  local i sorted
  for i in "${!VIO_DEV[@]}"; do
    sig_parts+=("${VIO_DEV[$i]}|${VIO_MODEL[$i]}|${VIO_METRIC[$i]}|${VIO_VALUE[$i]}")
  done
  sorted="$(printf '%s\n' "${sig_parts[@]}" | LC_ALL=C sort)"
  SIG="$(printf '%s' "$sorted" | sha256sum | cut -c1-16)"

  (( COOLDOWN > 0 )) || return 1           # 不冷却, 直接发送

  local last_sig last_time last_epoch now elapsed
  if [[ -f "$STATE_FILE" ]]; then
    last_sig="$(sed -n 's/.*"last_signature"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$STATE_FILE" | head -n1)"
    last_time="$(sed -n 's/.*"last_alert_time"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$STATE_FILE" | head -n1)"
    if [[ -n "$last_time" ]] && last_epoch="$(date -u -d "$last_time" +%s 2>/dev/null)"; then
      now="$(date -u +%s)"
      elapsed=$(( (now - last_epoch) / 60 ))
      if [[ "$last_sig" == "$SIG" ]] && (( elapsed < COOLDOWN )); then
        echo "同一告警冷却中 ($elapsed/$COOLDOWN min)，跳过发送"
        update_state
        return 0                            # 冷却中, 跳过
      fi
    fi
  fi
  update_state
  return 1
}

# ---------------------------------------------------------------- 发送邮件 ---
# 依赖 curl: smtp:// 明文 / STARTTLS(--ssl-reqd), smtps:// SMTPS(465)。
# 主题含非 ASCII(中文)时按 RFC 2047 编码为 =?UTF-8?B?...?=。

rfc2047_encode() {
  local s="$1" b64
  if LC_ALL=C grep -q '[^ -~]' <<<"$s"; then
    b64="$(printf '%s' "$s" | base64 -w0)"
    printf '=?UTF-8?B?%s?=' "$b64"
  else
    printf '%s' "$s"
  fi
}

# 从 "Name <addr>" 中取裸地址, 用作 curl --mail-from (信封发件人)
bare_addr() {
  local s="$1"
  if [[ "$s" =~ \<([^<>]+)\>$ ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  else
    printf '%s' "$s"
  fi
}

send_mail() {  # send_mail <subject> <body>
  local subject="$1" body="$2"
  local host port from to user pass scheme
  host="${CFG[smtp.host]}"
  port="${CFG[smtp.port]:-25}"
  from="${CFG[smtp.from]}"
  to="${CFG[smtp.to]}"
  user="${CFG[smtp.user]}"
  pass="${CFG[smtp.password]}"

  command -v curl >/dev/null 2>&1 || { echo "错误: 未安装 curl" >&2; return 1; }

  local -a rcpts=() addrs
  local a
  IFS=',' read -ra addrs <<<"$to"
  for a in "${addrs[@]}"; do
    a="${a//[[:space:]]/}"
    [[ -n "$a" ]] && rcpts+=("$a")
  done
  if (( ${#rcpts[@]} == 0 )); then
    echo "未配置收件人 (smtp.to)" >&2
    return 1
  fi

  scheme="smtp"
  local -a ssl_opt=()
  if bool_cfg smtp.use_ssl false; then
    scheme="smtps"
  elif bool_cfg smtp.use_tls false; then
    ssl_opt=(--ssl-reqd)
  fi

  # 构造带 RFC 头部的邮件正文 (curl 不做 RFC 2047, 主题需手工编码)
  local mailfile
  mailfile="$(mktemp)" || return 1
  {
    printf 'From: %s\n' "$from"
    printf 'To: %s\n' "$to"
    printf 'Subject: %s\n' "$(rfc2047_encode "$subject")"
    printf 'Date: %s\n' "$(date -u -R)"
    printf 'MIME-Version: 1.0\n'
    printf 'Content-Type: text/plain; charset=UTF-8\n'
    printf 'Content-Transfer-Encoding: 8bit\n'
    printf '\n%s\n' "$body"
  } > "$mailfile"

  local -a args=(
    --url "${scheme}://${host}:${port}"
    --mail-from "$(bare_addr "$from")"
    --silent --show-error --fail
    --connect-timeout 15
    --max-time 60
  )
  for a in "${rcpts[@]}"; do
    args+=(--mail-rcpt "$a")
  done
  [[ -n "$user" ]] && args+=(--user "${user}:${pass}")
  args+=("${ssl_opt[@]}")
  args+=(-T "$mailfile")

  local rc=0
  curl "${args[@]}" || rc=$?
  rm -f "$mailfile"

  if (( rc != 0 )); then
    echo "邮件发送失败: curl 退出码 $rc (${scheme}://${host}:${port})" >&2
    return 1
  fi
  return 0
}

# ------------------------------------------------------------------ 主流程 ---
main() {
  local conf="${HDSENTINEL_EMAIL_CONF:-$DEFAULT_CONF}"
  set_defaults
  parse_conf "$conf"

  local path extra_args
  path="${CFG[hdsentinel.path]:-/opt/hdsentinel/hdsentinel}"
  extra_args="${CFG[hdsentinel.extra_args]:-}"

  # 与 python subprocess 一致: 超时 120s, stderr 并入 stdout
  REPORT="$(timeout 120 "$path" $extra_args 2>&1 || true)"
  if [[ -z "$REPORT" ]]; then
    echo "错误: hdsentinel 无输出 ($path)" >&2
    return 1
  fi

  DEV_DEVICE=() DEV_MODEL=() DEV_TEMP=() DEV_HTEMP=() DEV_HEALTH=() DEV_PERF=()
  parse_disks <<<"$REPORT"
  if (( ${#DEV_DEVICE[@]} == 0 )); then
    echo "未解析到任何磁盘信息。hdsentinel 输出如下：" >&2
    echo "$REPORT" >&2
    return 1
  fi

  HEALTH_MIN="${CFG[alert.health_min]:-60}"
  PERF_MIN="${CFG[alert.performance_min]:-60}"
  TEMP_MAX="${CFG[alert.temp_max]:-55}"
  HI_MAX="${CFG[alert.highest_temp_max]:-65}"
  COOLDOWN="${CFG[alert.cooldown_minutes]:-60}"
  STATE_FILE="${CFG[alert.state_file]:-$DEFAULT_STATE_FILE}"

  local mode="${CFG[alert.mode]:-alert}"
  local subject body prefix="${CFG[smtp.subject_prefix]:-[HD Sentinel Alert]}"

  if [[ "$mode" == daily ]]; then
    body="HD Sentinel 每日状态报告

$REPORT"
    subject="$prefix 每日状态报告"
    if send_mail "$subject" "$body"; then
      echo "每日报告已发送"
    else
      echo "每日报告发送失败"
    fi
    return 0
  fi

  evaluate
  if (( ${#VIO_DEV[@]} == 0 )); then
    echo "无告警：${#DEV_DEVICE[@]} 个磁盘均正常"
    return 0
  fi

  if cooldown_check; then
    return 0
  fi

  subject="$prefix ${#VIO_DEV[@]} 项磁盘指标异常"
  body="$(build_summary)"
  if send_mail "$subject" "$body"; then
    echo "告警已发送：${#VIO_DEV[@]} 项指标异常"
  else
    echo "告警发送失败"
  fi
  return 0
}

main "$@"
